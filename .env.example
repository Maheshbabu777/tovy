# Copy to .env and fill in. Never commit .env.

# App. Expo reads EXPO_PUBLIC_* values from .env.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# End-to-end tests only (npm run test:e2e). Export them first: set -a && source .env && set +a
# SUPABASE_API_KEY is the project's secret key. The tests use it to create test users. Keep it private.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_API_KEY=

# Optional: path to a Chromium binary for the e2e tests.
CHROMIUM_PATH=

# CI does not read this file. Its secrets live in the GitHub repo settings (Actions secrets):
#   SUPABASE_ACCESS_TOKEN, DEV_PROJECT_REF, DEV_DB_PASSWORD
